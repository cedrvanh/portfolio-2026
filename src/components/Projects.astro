---
import GithubIcon from '../assets/icons/github.svg';
import { projects } from '../data/projects';
---

<section class="projects reveal-on-scroll" aria-labelledby="projects-title">
  <h2 id="projects-title" class="section-title">Selected work</h2>
  <ol class="project-list" role="list">
    {
      projects.map((project, i) => {
        const building = project.status === 'building';
        return (
          <li class="entry" style={`--i: ${i}`}>
            <div class="row">
              <span class="head">
                <h3 class="name">
                  {building && <span class="dot" aria-hidden="true" />}
                  {building && <span class="sr-only">Currently building — </span>}
                  {project.title}
                </h3>
                <span class="tagline">{project.tagline}</span>
                <span class="leader" aria-hidden="true" />
              </span>
              <span class="stack">{project.stack.join(' · ')}</span>
              {project.employer && <span class="employer">Built at {project.employer}</span>}
              {(project.href || project.repoHref) && (
                <ul class="links" role="list">
                  {project.href && (
                    <li>
                      <a href={project.href} target="_blank" rel="noopener noreferrer">
                        View<span class="sr-only"> {project.title}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  )}
                  {project.repoHref && (
                    <li>
                      <a href={project.repoHref} target="_blank" rel="noopener noreferrer">
                        <GithubIcon class="icon" aria-hidden="true" focusable="false" />
                        GitHub<span class="sr-only"> repository for {project.title}</span>
                      </a>
                    </li>
                  )}
                </ul>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style lang="scss">
  :global(.js) .projects.reveal-on-scroll {
    transform: none;
  }

  :global(.js) .entry {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 550ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 550ms cubic-bezier(0.2, 0.6, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .projects.is-visible .entry {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .project-list {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .entry {
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: block;
    padding-block: 1.15rem;
    text-decoration: none;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-shrink: 0;
    margin: 0;
    font-size: inherit;
    font-weight: 500;
    white-space: nowrap;
  }

  .dot {
    align-self: center;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .tagline {
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .leader {
    flex: 1;
    min-width: 1.5rem;
    align-self: center;
    border-bottom: 1px dotted var(--muted);
    opacity: 0.45;
    transform: translateY(0.15em);
    transition: opacity 150ms ease;
  }

  .stack {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    color: var(--muted);
    opacity: 0.85;
  }

  .employer {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--muted);
    opacity: 0.7;
  }

  .entry:hover .leader {
    opacity: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding-block: 0.35rem;
      margin-block: -0.35rem;
      font-size: var(--text-sm);
      color: var(--muted);
      text-decoration: none;
      transition: color 150ms ease;
    }

    a:hover,
    a:focus-visible {
      color: var(--accent);
    }
  }

  .icon {
    width: 1em;
    height: 1em;
    fill: currentColor;
    opacity: 0.55;
    transition: opacity 150ms ease;
  }

  .links a:hover .icon,
  .links a:focus-visible .icon {
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 34rem) {
    .head {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }

    .leader {
      display: none;
    }

    .tagline {
      flex-basis: 100%;
      order: 4;
      white-space: normal;
    }

    .stack {
      margin-top: 0.45rem;
    }
  }
</style>
