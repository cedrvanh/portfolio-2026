---
import { skills } from '../data/skills';
---

<section class="skills reveal-on-scroll" aria-labelledby="skills-title">
  <h2 id="skills-title" class="section-title">Technologies & skills</h2>
  <dl class="index">
    {
      skills.map((group, g) => (
        <div class="group" style={`--i: ${g}`}>
          <dt class="label">{group.label}</dt>
          <dd class="tags">
            {group.items.map((item) => (
              <span class:list={['tag', { 'is-core': item.core }]}>{item.name}</span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style lang="scss">
  :global(.js) .skills.reveal-on-scroll {
    transform: none;
  }

  :global(.js) .group {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 550ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 550ms cubic-bezier(0.2, 0.6, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 80ms);
  }

  .skills.is-visible .group {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .group {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .index {
    margin-top: 1.75rem;
  }

  .group {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0.5rem 1.5rem;

    & + & {
      margin-top: 1.6rem;
    }
  }

  .label {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .tag {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 5%, var(--paper));
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    color: var(--muted);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .tag.is-core {
    background: color-mix(in srgb, var(--ink) 9%, var(--paper));
    color: color-mix(in srgb, var(--ink) 80%, var(--muted));
  }

  @media (max-width: 34rem) {
    .group {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }
</style>
